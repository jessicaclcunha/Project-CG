<?xml version="1.0" encoding="utf-8"?>
<scene version="3.0.0">

    <!-- Integrador: path tracing directo (equivalente ao DistributedShader) -->
    <integrator type="direct">
        <integer name="emitter_samples" value="1"/>
        <integer name="bsdf_samples" value="1"/>
    </integrator>

    <!-- Câmara -->
    <sensor type="perspective">
        <float name="fov" value="60.0"/>
        <string name="fov_axis" value="y"/>
        <transform name="to_world">
            <lookat origin="0,0.5,-5"
                    target="0,0,3"
                    up="0,1,0"/>
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="218"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width"  value="640"/>
            <integer name="height" value="640"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <bsdf type="diffuse" id="mat_diff">
        <rgb name="reflectance" value="0.6, 0.2, 0.2"/>
    </bsdf>
    <bsdf type="roughplastic" id="mat_rough">
        <rgb name="diffuse_reflectance"  value="0.2, 0.4, 0.7"/>
        <rgb name="specular_reflectance" value="0.8, 0.8, 0.8"/>
        <float name="alpha" value="0.534522"/>
        <string name="distribution" value="ggx"/>
    </bsdf>
    <bsdf type="roughplastic" id="mat_mid">
        <rgb name="diffuse_reflectance"  value="0.2, 0.6, 0.2"/>
        <rgb name="specular_reflectance" value="0.8, 0.8, 0.8"/>
        <float name="alpha" value="0.196116"/>
        <string name="distribution" value="ggx"/>
    </bsdf>
    <bsdf type="roughplastic" id="mat_shiny">
        <rgb name="diffuse_reflectance"  value="0.6, 0.4, 0.1"/>
        <rgb name="specular_reflectance" value="0.9, 0.9, 0.9"/>
        <float name="alpha" value="0.0631194"/>
        <string name="distribution" value="ggx"/>
    </bsdf>
    <shape type="sphere">
        <point name="center" x="-3" y="0" z="5"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_diff"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="-1" y="0" z="5"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_rough"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="1" y="0" z="5"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_mid"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="3" y="0" z="5"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_shiny"/>
    </shape>
    <emitter type="constant">
        <rgb name="radiance" value="0.05, 0.05, 0.05"/>
    </emitter>
    <emitter type="point">
        <rgb name="intensity" value="300, 300, 300"/>
        <point name="position" x="-1" y="2" z="0"/>
    </emitter>

</scene>
