<?xml version="1.0" encoding="utf-8"?>
<scene version="3.0.0">

    <!-- Integrador: path tracing directo (equivalente ao DistributedShader) -->
    <integrator type="direct">
        <integer name="emitter_samples" value="1"/>
        <integer name="bsdf_samples" value="1"/>
    </integrator>

    <!-- Câmara -->
    <sensor type="perspective">
        <float name="fov" value="60.0"/>
        <string name="fov_axis" value="y"/>
        <transform name="to_world">
            <lookat origin="0,0.5,-5"
                    target="0,0,3"
                    up="0,1,0"/>
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="218"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width"  value="640"/>
            <integer name="height" value="640"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <bsdf type="roughplastic" id="mat_plas_s">
        <!-- Ashikhmin-Shirley: alpha_u=0.408248, alpha_v=0.408248 -->
        <rgb name="diffuse_reflectance"  value="0.1, 0.2, 0.8"/>
        <rgb name="specular_reflectance" value="0.5, 0.5, 0.5"/>
        <float name="alpha" value="0.408248"/>
        <string name="distribution" value="ggx"/>
    </bsdf>
    <bsdf type="roughplastic" id="mat_plas_r">
        <!-- Ashikhmin-Shirley: alpha_u=0.156174, alpha_v=0.156174 -->
        <rgb name="diffuse_reflectance"  value="0.1, 0.2, 0.8"/>
        <rgb name="specular_reflectance" value="0.5, 0.5, 0.5"/>
        <float name="alpha" value="0.156174"/>
        <string name="distribution" value="ggx"/>
    </bsdf>
    <bsdf type="roughplastic" id="mat_metal_a">
        <!-- Ashikhmin-Shirley: alpha_u=0.0631194, alpha_v=0.408248 -->
        <rgb name="diffuse_reflectance"  value="1, 0.71, 0.29"/>
        <rgb name="specular_reflectance" value="0.9, 0.75, 0.5"/>
        <float name="alpha" value="0.235684"/>
        <string name="distribution" value="ggx"/>
    </bsdf>
    <bsdf type="roughplastic" id="mat_metal_p">
        <!-- Ashikhmin-Shirley: alpha_u=0.0446767, alpha_v=0.0446767 -->
        <rgb name="diffuse_reflectance"  value="1, 0.71, 0.29"/>
        <rgb name="specular_reflectance" value="0.9, 0.75, 0.5"/>
        <float name="alpha" value="0.0446767"/>
        <string name="distribution" value="ggx"/>
    </bsdf>
    <shape type="sphere">
        <point name="center" x="-3" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_plas_s"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="-1" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_plas_r"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="1" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_metal_a"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="3" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_metal_p"/>
    </shape>
    <emitter type="point">
        <rgb name="intensity" value="500, 500, 500"/>
        <point name="position" x="0" y="4" z="0"/>
    </emitter>
    <emitter type="constant">
        <rgb name="radiance" value="0.02, 0.02, 0.02"/>
    </emitter>
    <bsdf type="diffuse" id="mat_floor">
        <rgb name="reflectance" value="0.07, 0.07, 0.07"/>
    </bsdf>
    <shape type="obj">
        <string name="filename" value="floor.obj"/>
        <ref id="mat_floor"/>
    </shape>

</scene>
