<?xml version="1.0" encoding="utf-8"?>
<scene version="3.0.0">

    <!-- Integrador: path tracing directo (equivalente ao DistributedShader) -->
    <integrator type="direct">
        <integer name="emitter_samples" value="1"/>
        <integer name="bsdf_samples" value="1"/>
    </integrator>

    <!-- Câmara -->
    <sensor type="perspective">
        <float name="fov" value="60.0"/>
        <string name="fov_axis" value="y"/>
        <transform name="to_world">
            <lookat origin="0,0.5,-5"
                    target="0,0,3"
                    up="0,1,0"/>
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="218"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width"  value="640"/>
            <integer name="height" value="640"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <bsdf type="roughconductor" id="mat_gold">
        <rgb name="specular_reflectance" value="1, 0.71, 0.29"/>
        <float name="alpha" value="0.3"/>
        <string name="distribution" value="ggx"/>
        <string name="material" value="Au"/>
    </bsdf>
    <bsdf type="roughconductor" id="mat_copper">
        <rgb name="specular_reflectance" value="0.95, 0.64, 0.54"/>
        <float name="alpha" value="0.3"/>
        <string name="distribution" value="ggx"/>
        <string name="material" value="Au"/>
    </bsdf>
    <bsdf type="roughconductor" id="mat_silver">
        <rgb name="specular_reflectance" value="0.95, 0.93, 0.88"/>
        <float name="alpha" value="0.3"/>
        <string name="distribution" value="ggx"/>
        <string name="material" value="Au"/>
    </bsdf>
    <bsdf type="roughconductor" id="mat_iron">
        <rgb name="specular_reflectance" value="0.56, 0.57, 0.58"/>
        <float name="alpha" value="0.3"/>
        <string name="distribution" value="ggx"/>
        <string name="material" value="Au"/>
    </bsdf>
    <shape type="sphere">
        <point name="center" x="-3" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_gold"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="-1" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_copper"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="1" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_silver"/>
    </shape>
    <shape type="sphere">
        <point name="center" x="3" y="0" z="3"/>
        <float name="radius" value="0.8"/>
        <ref id="mat_iron"/>
    </shape>
    <shape type="obj">
        <string name="filename" value="key_light_0.obj"/>
        <emitter type="area">
            <rgb name="radiance" value="127.324, 127.324, 127.324"/>
        </emitter>
    </shape>
    <shape type="obj">
        <string name="filename" value="key_light_1.obj"/>
        <emitter type="area">
            <rgb name="radiance" value="127.324, 127.324, 127.324"/>
        </emitter>
    </shape>
    <emitter type="point">
        <rgb name="intensity" value="100, 100, 100"/>
        <point name="position" x="-5" y="2" z="1"/>
    </emitter>
    <emitter type="constant">
        <rgb name="radiance" value="0.02, 0.02, 0.02"/>
    </emitter>
    <bsdf type="diffuse" id="mat_floor">
        <rgb name="reflectance" value="0.07, 0.07, 0.07"/>
    </bsdf>
    <shape type="obj">
        <string name="filename" value="floor.obj"/>
        <ref id="mat_floor"/>
    </shape>

</scene>
